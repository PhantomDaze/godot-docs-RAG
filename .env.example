# Godot Docs RAG — 嵌入引擎配置
# 复制此文件为 .env 并修改

# 嵌入引擎: "local" 或 "openai"
#   local  — 本地 BGE-M3 模型（免费，首次需下载 ~2GB）
#   openai — OpenAI 兼容 API（按 token 付费，需 API key）
# EMBED_PROVIDER=local

# ── 计算设备（仅 local 有效）─────────────────────────────────
#   cuda — NVIDIA GPU（需要 CUDA 版 PyTorch）
#   mps  — Apple Silicon GPU
#   cpu  — 中央处理器
#   不设置则自动检测可用设备，或运行时交互选择
# EMBED_DEVICE=cpu

# ── 向量维度 ─────────────────────────────────────────────────
#   BGE-M3 支持: 1024（完整）、768、512、256（截断维度）
#   OpenAI text-embedding-3-small 默认 1536
#   OpenAI text-embedding-3-large 默认 3072
#   不设置则使用模型默认维度，或运行时交互选择
# EMBED_DIM=1024

# ── 本地模型路径（可选）───────────────────────────────────────
#   默认自动检测: ./bge-m3-model/ → ../bge-m3/ → HuggingFace 下载
# LOCAL_MODEL_PATH=../bge-m3

# ── OpenAI 兼容 API（仅在 EMBED_PROVIDER=openai 时需要）───
# OPENAI_API_KEY=sk-your-key-here

# API 地址（可选，默认 https://api.openai.com/v1）
# 必须包含 /v1 后缀！SDK 会拼出 ${base_url}/embeddings
# 正确示例:
#   OpenAI 官方       → 不填，用默认值
#   第三方代理         → https://api.xxx.com/v1
#   本地 LiteLLM       → http://localhost:8000/v1
#   本地 ollama        → http://localhost:11434/v1
# 错误示例:
#   https://api.xxx.com           ← 缺 /v1，请求拼不对
# OPENAI_BASE_URL=https://api.openai.com/v1

# 嵌入模型名（可选，默认 text-embedding-3-small）
# EMBED_MODEL=text-embedding-3-small
